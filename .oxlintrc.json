{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "jest",
    "react",
    "jsx-a11y"
  ],
  "jsPlugins": ["./dev/lints/conventions.js"],
  "categories": {},
  "rules": {
    /* Correctness: rules whose violations turn into runtime errors, safe to apply everywhere */
    // default rules
    "constructor-super": "error",
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-caller": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-eval": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-unassigned-vars": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-expressions": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": "error",
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-useless-rename": "error",
    "no-with": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",

    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-comparison-sequence": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/missing-throw": "error",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "error",
    "oxc/uninvoked-array-callback": "error",

    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-parameter-property-assignment": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/unbound-method": "error",

    "unicorn/no-await-in-promise-methods": "error",
    "unicorn/no-empty-file": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-single-promise-in-promise-methods": "error",
    "unicorn/no-thenable": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-length-check": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-set-size": "error",
    "unicorn/prefer-string-starts-ends-with": "error",

    // customized rules
    "import/default": "off", // missing default imports are the type checker's job
    "import/namespace": "off", // missing named imports are the type checker's job

    "jsdoc/check-property-names": "error", // catch duplicate JSDoc property names
    "jsdoc/check-tag-names": "error", // catch invalid JSDoc tag names
    "jsdoc/implements-on-classes": "off", // @implements constraints are project specific
    "jsdoc/no-defaults": "error", // avoid duplicating @default and the default argument
    // types come from TypeScript, not from JSDoc
    "jsdoc/require-property": "off", // do not require property tags
    "jsdoc/require-property-description": "off", // do not require property descriptions
    "jsdoc/require-property-name": "off", // do not require property names
    "jsdoc/require-property-type": "off", // do not require property types
    "jsdoc/require-yields": "off", // do not require yield tags

    "promise/no-callback-in-promise": "error", // no callback style inside a promise
    "promise/no-new-statics": "off", // the type checker catches new Promise.resolve
    "promise/valid-params": "off", // promise argument checking is the type checker's job

    /* Perf */
    "unicorn/prefer-array-find": "error", // use find when looking for a single element

    /* Restriction */
    "default-case": "error", // require a default case in switch statements
    "no-var": "error", // no var

    "typescript/no-explicit-any": "error", // no any
    "typescript/no-non-null-assertion": "error", // no non-null assertion operator
    "typescript/use-unknown-in-catch-callback-variable": "error", // catch clauses use unknown
    "typescript/no-empty-object-type": "error", // no empty object type
    "typescript/no-import-type-side-effects": "off", // handled by typescript/consistent-type-imports instead

    "unicorn/prefer-node-protocol": "error", // import Node built-ins with the node: protocol

    /* Suspicious */
    "import/no-empty-named-blocks": "error", // catch empty named import blocks

    "promise/no-multiple-resolved": "error", // catch a promise resolved or rejected twice

    "typescript/no-unnecessary-template-expression": "error", // catch pointless template literals
    "typescript/no-unnecessary-type-assertion": "error", // catch pointless type assertions
    "typescript/no-unsafe-type-assertion": "error", // no unsafe type assertions

    /* Pedantic */
    "eqeqeq": "error", // require ===

    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-expect-error": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "ts-check": false,
        "minimumDescriptionLength": 2
      }
    ], // ts- directives must carry a reason
    "typescript/prefer-ts-expect-error": "error", // prefer ts-expect-error so a stale suppression is reported
    "typescript/no-deprecated": "error", // catch deprecated APIs
    "typescript/no-misused-promises": "error", // catch misused promises
    "typescript/prefer-nullish-coalescing": "error", // use nullish coalescing for null and undefined
    "typescript/require-await": "error", // an async function should await something
    "typescript/switch-exhaustiveness-check": "error", // switch statements must be exhaustive
    "typescript/strict-boolean-expressions": "error", // no implicit truthiness in conditions
    "typescript/restrict-plus-operands": "error", // restrict the operand types of +
    "typescript/no-unsafe-assignment": "error", // catch assignment from any
    "typescript/no-unsafe-member-access": "error", // catch member access on any
    "typescript/no-unsafe-call": "error", // catch calling an any
    "typescript/no-unsafe-return": "error", // catch returning an any
    "typescript/no-unsafe-argument": "error", // catch passing an any as an argument

    /* Style */
    "func-style": ["error", "expression"], // prefer arrow function expressions over declarations
    "no-duplicate-imports": "error", // merge imports from the same module
    "sort-imports": "off", // no autofix, unstable, and oxfmt's experimentalSortImports already sorts them

    "import/consistent-type-specifier-style": "off", // handled by typescript/consistent-type-imports instead

    "typescript/prefer-for-of": "error", // use for-of when the index is not needed
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ], // type imports use the type keyword
    "typescript/consistent-type-definitions": ["error", "type"], // prefer type over interface

    /* Project-Specific Custom Restrictions */
    "node/no-process-env": "error",
    // worth enabling one day, but too many call sites use it today
    // "no-restricted-globals": [
    //   "error",
    //   {
    //     "name": "Date",
    //     "message": "Use Effect Clock instead of global Date."
    //   }
    // ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:child_process",
            "message": "Use @effect/platform CommandExecutor instead."
          },
          { "name": "node:fs", "message": "Use @effect/platform FileSystem instead." },
          { "name": "node:fs/promises", "message": "Use @effect/platform FileSystem instead." },
          { "name": "node:path", "message": "Use @effect/platform Path instead." },
          { "name": "node:os", "message": "Use application/platform services instead." },
          { "name": "node:sqlite", "message": "Use DrizzleService service instead." }
        ]
      }
    ],
    "conventions/no-barrel-file": "error",
    "conventions/colocated-tests": "error",
    "conventions/module-boundaries": "error",
    "conventions/no-project-alias-outside-web": "error",

    // with @effect/vitest's it.live/it.effect, expect sits inside the Effect.gen callback,
    // which oxlint mistakes for being outside the test block, so this is off globally
    "jest/no-standalone-expect": "off"
  },
  "overrides": [
    {
      "files": ["src/server/**/*.ts"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "rules": {
        "no-restricted-imports": "off",
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx"
      ],
      "rules": {
        "no-restricted-imports": "off",
        // a test must assert something — `expect*` covers the helpers that hold
        // the assertions for a table of cases, which the rule cannot see into
        "jest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }],
        "jest/no-conditional-expect": "error", // no expect inside a conditional
        "jest/no-disabled-tests": "off", // skipping tests is a project decision
        "jest/no-export": "error", // no exports from a test file
        "jest/no-focused-tests": "error", // no test.only, so it cannot be committed
        "jest/require-to-throw-message": "off", // asserting on error messages is a project decision
        "jest/valid-describe-callback": "error", // validate describe callbacks, no async and so on
        // expect must be followed by an assertion; two arguments because Vitest
        // takes a message as the second, which is how a loop over adapters says
        // which one failed
        "jest/valid-expect": ["error", { "maxArgs": 2 }],
        "jest/valid-title": "error" // test and describe titles must not be empty

        // unsafe `as` is banned in tests too, see CONTRIBUTING.md
        // typescript/no-unsafe-type-assertion is already an error globally
      }
    },
    {
      "files": ["**/*.?([mc])[jt]sx"],
      "rules": {
        /* React Correctness */
        "react/rules-of-hooks": "error", // enforce the rules of hooks, no calls inside conditionals or loops
        "react/exhaustive-deps": "error", // dependency arrays must be complete
        "react/jsx-key": "error", // rendered lists need a key
        "react/jsx-no-duplicate-props": "error", // catch duplicate JSX props
        "react/jsx-no-undef": "error", // catch undefined components and JSX elements
        "react/jsx-no-target-blank": "error", // catch the security risk in target="_blank"
        "react/no-string-refs": "error", // no legacy string refs
        "react/no-danger-with-children": "error", // no dangerouslySetInnerHTML alongside children
        "react/void-dom-elements-no-children": "error", // void elements such as img and br take no children
        "react/no-direct-mutation-state": "error", // no direct state mutation

        /* React Style */
        "react/jsx-no-useless-fragment": "error", // catch pointless fragments
        "react/jsx-fragments": "error", // use the shorthand fragment syntax
        "react/no-array-index-key": "error", // do not use an array index as a key

        /* JSX A11y */
        "jsx_a11y/alt-text": "off", // alt text on images
        "jsx-a11y/anchor-has-content": "error", // anchors need content
        "jsx-a11y/anchor-is-valid": "error", // anchors must be valid
        "jsx-a11y/aria-activedescendant-has-tabindex": "error", // aria-activedescendant needs a tabindex
        "jsx-a11y/aria-props": "error", // only valid ARIA attributes
        "jsx-a11y/aria-role": "error", // only valid ARIA roles
        "jsx-a11y/aria-unsupported-elements": "error", // no ARIA attributes on unsupported elements
        "jsx-a11y/autocomplete-valid": "error", // autocomplete values must be valid
        "jsx-a11y/click-events-have-key-events": "off", // too noisy here, worth enabling on a project that needs it
        "jsx-a11y/heading-has-content": "error", // headings need content
        "jsx-a11y/html-has-lang": "error", // the html element needs a lang attribute
        "jsx-a11y/iframe-has-title": "error", // iframes need a title
        "jsx-a11y/img-redundant-alt": "off", // unreliable once alt text is not English
        "jsx-a11y/label-has-associated-control": "error", // labels must be tied to a control
        "jsx-a11y/lang": "error", // lang must be a valid BCP 47 tag
        "jsx-a11y/media-has-caption": "error", // media elements need captions
        "jsx-a11y/mouse-events-have-key-events": "off", // too noisy here, worth enabling on a project that needs it
        "jsx-a11y/no-access-key": "error", // no accessKey
        "jsx-a11y/no-aria-hidden-on-focusable": "error", // no aria-hidden on a focusable element
        "jsx-a11y/no-autofocus": "error", // no autoFocus
        "jsx-a11y/no-distracting-elements": "error", // no marquee, blink and friends
        "jsx-a11y/no-noninteractive-tabindex": "error", // no tabindex on non-interactive elements
        "jsx-a11y/no-redundant-roles": "error", // no role that repeats the implicit one
        "jsx-a11y/prefer-tag-over-role": "error", // prefer semantic HTML over a role attribute
        "jsx-a11y/role-has-required-aria-props": "error", // a role must carry its required ARIA attributes
        "jsx-a11y/role-supports-aria-props": "error", // only ARIA attributes the role supports
        "jsx-a11y/scope": "error", // scope belongs on th only
        "jsx-a11y/tabindex-no-positive": "error" // no positive tabindex
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/*.generated.*",
    "**/generated/**",
    "**/*.tsbuildinfo",
    "src/lib/$path.ts",
    "src/lib/i18n/locales/*/messages.ts",
    "src/lib/i18n/locales/*/messages.json",
    "src/routeTree.gen.ts",
    "e2e/**",
    "scripts/**",
    "dev/lints/**",
    "dev/lints/**",
    "**/*.config.*"
  ],
  "options": {
    "typeCheck": false,
    "typeAware": true,
    "reportUnusedDisableDirectives": "deny",
    "maxWarnings": 10,
    "denyWarnings": false
  }
}
